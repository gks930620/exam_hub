      "sh-1": "0 1px 2px rgba(30, 34, 70, .05)",
      "sh-2": "0 4px 14px rgba(30, 34, 70, .08)",
      "sh-3": "0 12px 32px rgba(30, 34, 70, .15)",
      "sh-point": "0 0 0 3px var(--point-soft)"
