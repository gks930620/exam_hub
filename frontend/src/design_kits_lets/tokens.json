      "btn-hover-bg": "var(--point-hover)",
      "btn-shadow": "none",
      "btn-press": "translateY(1px)",
      "input-bg": "var(--surface-alt)",
      "active-bg": "var(--point-soft)",
      "active-fg": "var(--point-text)",
