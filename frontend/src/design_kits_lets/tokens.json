      "sh-2": "0 4px 14px rgba(0, 0, 0, .35)",
      "sh-3": "0 12px 32px rgba(0, 0, 0, .5)",
      "sh-point": "0 0 0 3px var(--point-soft)"
    }
  },

  "effect": {
