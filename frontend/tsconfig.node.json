{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // ⚠️ outDir 이 없으면 tsc -b 가 vite.config.ts 를 같은 폴더에 vite.config.js 로 내보낸다.
    //    Vite 는 .js 를 .ts 보다 먼저 읽으므로, 그 뒤로는 vite.config.ts 를 고쳐도 반영되지 않는다.
    //    composite 프로젝트는 noEmit 을 쓸 수 없으므로(TS6310) 출력 위치를 소스 밖으로 뺀다.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node/tsconfig.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
