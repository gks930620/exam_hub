# ============================================
# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore/.dockerignore 로 제외되어 VCS/이미지에 포함되지 않는다.
# ⚠️ 실제 시크릿을 이 .env.example 에 채우지 말 것 (이 파일은 커밋 대상).
#
# 이 서비스의 인증은 X-Device-Id 헤더 기반 기기 식별이라
# OAuth2(KAKAO/GOOGLE)·JWT·Supabase 관련 키는 존재하지 않는다.
# ============================================

# ============================================
# 운영 환경(Railway) 설정
#  - 로컬(dev)은 H2 인메모리라 아래 DB 값이 필요 없다.
#  - 운영은 Railway MySQL 사용. 아래 값들은 보통 Railway 대시보드의
#    "서비스 Variables"에 등록한다(.env 로 배포하지 않음). 여긴 참고용 목록.
# ============================================

# 데이터베이스 (Railway MySQL) — prod 프로파일 필수(기본값 없음: 미설정 시 기동 실패/fail-fast)
#   Railway Reference Variables 로 조립 예시:
# SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}
# SPRING_DATASOURCE_USERNAME=${{MySQL.MYSQLUSER}}
# SPRING_DATASOURCE_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# 공개 base URL (운영) — sitemap.xml/robots.txt 절대 URL 조립에 사용
# APP_PUBLIC_BASE_URL=https://your-app.up.railway.app


# ============================================
# exam-hub 전용 (수집/알림)
#  - 개발(dev/test)은 키 없이 Mock 소스 + 로그 발송으로 전체 파이프라인이 동작한다.
#  - 아래 값은 실 연동 시에만 필요.
# ============================================

# 공공데이터포털 큐넷 국가기술자격 시험일정 API 서비스키 (발급 후 주입).
# 미설정이면 dev 는 Mock, prod 는 QnetApiScheduleSource 스텁(빈 목록)으로 동작.
# QNET_API_KEY=
# QNET_API_BASE_URL=https://apis.data.go.kr/B490007/qualExamSchd


# 카카오톡 "나에게 보내기" — 사업자등록 없이 본인 카톡으로 알림을 테스트할 때 (개발용)
# oauth.yml 에 카카오 키가 있어야 하고, scope 에 talk_message 가 포함돼야 한다.
KAKAO_MEMO_ENABLED=false


# ── 이메일 알림 (지금 유일하게 살아 있는 알림 채널) ──
# Gmail: 구글계정 → 보안 → 2단계 인증 켜기 → "앱 비밀번호" 생성 → 16자리를 MAIL_PASSWORD 에.
#        평소 로그인 비밀번호를 넣으면 인증 거부된다(535). 일 500통 제한.
# MAIL_ENABLED=true
# MAIL_USERNAME=본인계정@gmail.com
# MAIL_PASSWORD=앱비밀번호16자리
# MAIL_FROM=본인계정@gmail.com
# MAIL_SMTP_AUTH / MAIL_SMTP_STARTTLS 는 Gmail·SES 면 건드릴 필요 없다(기본 true).


# ── 소셜 로그인 (oauth.yml 이 이 값들을 참조한다) ──
# oauth.yml 에는 구조만 있고 키는 여기 있다. cp oauth.yml.example oauth.yml 먼저.
# 값이 없으면 로그인만 꺼지고 나머지는 정상 동작한다.
# KAKAO_CLIENT_ID=          # 개발자센터 → 앱 키 → REST API 키
# KAKAO_CLIENT_SECRET=      # '사용 안 함'이면 빈 값으로 둔다
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=     # 구글은 필수 (콘솔 재발급 직후에만 보인다)


# ── 매니저(운영자) 계정 ──
# 보통은 **비워 둔다.**
#   로컬: data.sql 이 manager / pass1234 를 넣는다
#   운영: DB 에 직접 INSERT (진행사항/02_내가_할일.md 4순위)
#
# 여기에 값을 넣으면 기동할 때마다 그 값으로 계정을 만들거나 비밀번호를 덮어쓴다.
# 비밀번호를 잊었을 때 되찾는 길이지만, 평소엔 data.sql/DB 와 어긋나므로 비워 두는 게 낫다.
# 배포에서는 10자 이상이어야 하고, 짧으면 RailwayDeploymentValidator 가 기동을 막는다.
# MANAGER_USERNAME=
# MANAGER_PASSWORD=


# ── 큐넷 실 API 수집 ──
# 켜 두면 05:00 스케줄러가 매일 일정을 받아온다. 기동 시에는 안 돈다(일 한도 1,000회 보호).
# QNET_API_ENABLED=true
