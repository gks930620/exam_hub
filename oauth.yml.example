# ═══════════════════════════════════════════════════════════════
# 소셜 로그인 registration — 이 파일을 oauth.yml 로 복사하세요.
#
#   cp oauth.yml.example oauth.yml
#
# ⚠️ 여기엔 키를 적지 않습니다. **키는 .env 에** 넣고 이 파일은 참조만 합니다.
#    비밀값이 한 곳에 모여 있어야 어디를 봐야 하는지 헷갈리지 않습니다.
#
#      .env:
#        KAKAO_CLIENT_ID=...
#        KAKAO_CLIENT_SECRET=        (개발자센터에서 '사용 안 함'이면 빈 값)
#        GOOGLE_CLIENT_ID=...
#        GOOGLE_CLIENT_SECRET=...
#
# 이 파일이 없으면 **로그인만 꺼지고** 시험 조회·커뮤니티 읽기는 그대로 돕니다.
# oauth.yml 은 .gitignore 에 있습니다.
#
# 📦 배포(Railway)에는 이 파일이 없습니다. 대신 환경변수로 같은 값을 넣습니다 —
#    목록은 진행사항/02_내가_할일.md 4순위(배포)에 그대로 적어 뒀습니다.
#    카카오 provider(authorization/token/user-info URI)는 비밀이 아니라서
#    application.yml 에 있으므로 배포 때 따로 넣을 필요가 없습니다.
# ═══════════════════════════════════════════════════════════════
spring:
  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: ${KAKAO_CLIENT_ID}
            client-secret: ${KAKAO_CLIENT_SECRET:}
            client-authentication-method: client_secret_post
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            # ⚠️ 개발자센터 '동의항목'에서 켠 것만 넣을 수 있습니다.
            #    안 켠 항목을 요청하면 KOE205 로 로그인 자체가 막힙니다.
            #    account_email·talk_message 는 비즈 앱(사업자 정보) 전환 후에만 켤 수 있습니다.
            scope:
              - profile_nickname
              - profile_image
            client-name: Kakao

          # 구글은 Client Secret 이 필수입니다(콘솔에서 재발급 직후에만 보입니다).
          # .env 의 GOOGLE_CLIENT_SECRET 을 채운 뒤 주석을 푸세요.
          # 빈 값으로 켜면 "Client secret must not be empty" 로 기동이 깨집니다.
          # google:
          #   client-id: ${GOOGLE_CLIENT_ID}
          #   client-secret: ${GOOGLE_CLIENT_SECRET}
          #   scope:
          #     - profile
          #     - email
